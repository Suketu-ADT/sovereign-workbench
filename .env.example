# Sovereign On-Premise Workbench — Root Deployment Environment Configuration
# Copy this file to .env and configure strong, unique secrets before production deployment.

ENVIRONMENT=production

# ── PostgreSQL Database ──────────────────────────────────────────────────────────
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_IN_PRODUCTION
POSTGRES_DB=sovereign
DATABASE_URL=postgresql+asyncpg://sovereign:CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_IN_PRODUCTION@postgres:5432/sovereign

# ── Cryptographic Security & JWT ────────────────────────────────────────────────
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── Qdrant Vector Engine ────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=operational_manuals
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=3

# ── AI Defense Layers & Models ──────────────────────────────────────────────────
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_URL=http://127.0.0.1:11434
PROMPT_GUARD_MODEL=llama-guard3:1b
PROMPT_GUARD_TIMEOUT=3.0

LOCAL_VLM_ENABLED=false
PLANNER_MODEL_ENABLED=false

# ── Multi-Model Routing & Sovereign Mode ──────────────────────────────────────────
# Development model provider (Hugging Face Inference Providers via OpenAI SDK)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Sovereign deployment (air-gapped): when true, external providers are blocked
SOVEREIGN_MODE=false

# Local model server (Ollama / vLLM / OpenAI-compatible local server)
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
