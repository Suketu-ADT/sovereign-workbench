# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sovereign:sovereign@db:5432/sovereign

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── Seed ──────────────────────────────────────────────────────
SEED_PASSWORD=changeme123

# ── Prompt Guard (Llama-Guard-3) ──────────────────────────────
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_URL=http://127.0.0.1:11434
PROMPT_GUARD_MODEL=llama-guard3:1b
PROMPT_GUARD_TIMEOUT=3.0

# ── Qdrant Vector DB & RAG ────────────────────────────────────
QDRANT_STORAGE_PATH=./qdrant_storage
# Optional remote Qdrant container URL (leave commented for local embedded mode):
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=operational_manuals
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=3

# ── Cloud LLM & Vision API Models (Qwen 2.5 32B & Qwen 2.5-VL 72B) ────
# Provide your API key (e.g. OpenRouter, DashScope, or OpenAI-compatible)
LLM_API_KEY=your_openrouter_or_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Multimodal Vision (Qwen2.5-VL 72B / OpenCV) ───────────────
VISION_MODEL_ENABLED=true
VISION_MODEL_URL=http://127.0.0.1:11434
VISION_MODEL_NAME=qwen/qwen-2.5-vl-72b-instruct
VISION_TIMEOUT=30.0

# ── LangGraph Planner & Reasoning (Qwen2.5-32B) ───────────────
PLANNER_MODEL_ENABLED=true
PLANNER_MODEL_URL=http://127.0.0.1:11434
PLANNER_MODEL_NAME=qwen/qwen2.5-32b-instruct
PLANNER_TIMEOUT=30.0

# ── Multi-Model Routing & Sovereign Mode ───────────────────────
# Development model provider (Hugging Face Inference Providers via OpenAI SDK)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Sovereign deployment (air-gapped): when true, external providers are blocked
SOVEREIGN_MODE=false

# Local model server (Ollama / vLLM / OpenAI-compatible local server)
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1




